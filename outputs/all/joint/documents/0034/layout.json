          "box": [
            62.0,
            442.8,
            534.5,
            459.075
          ],
          "block_id": "t00002",
          "type": "text",
          "text": "方针和资源分配；管理层负责制定质量标准、协调跨部门工作；执行层负责日常数据质量监控与问题修",
          "parent_id": "h0002",
          "level": null,
          "size": 10.5,
          "font": "cjk",
          "lane": "column0",
          "color_hex": null
        },
        {
