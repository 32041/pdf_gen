          "box": [
            62.0,
            536.5,
            429.5,
            552.775
          ],
          "block_id": "t00003",
          "type": "text",
          "text": "务知识，并定期接受培训。机构应保障岗位人员的工作独立性，避免利益冲突。",
          "parent_id": "h0003",
          "level": null,
          "size": 10.5,
