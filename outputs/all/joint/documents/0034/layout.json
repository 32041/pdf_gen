          ],
          "block_id": "t00002",
          "type": "text",
          "text": "公共服务机构应建立数据质量治理架构，明确决策层、管理层和执行层的职责。决策层负责审批数据质量",
          "parent_id": "h0002",
          "level": null,
          "size": 10.5,
          "font": "cjk",
          "lane": "column0",
          "color_hex": null
        },
        {
