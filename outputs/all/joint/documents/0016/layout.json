          "block_id": "t00001",
          "type": "text",
          "text": "维护仓储物安全，存货方应按时支付费用并提供必要单证。协议有效期12个月，期满前可协商",
          "parent_id": "h0001",
          "level": null,
          "size": 11,
          "font": "cjk",
