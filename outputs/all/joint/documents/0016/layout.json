            144.0
          ],
          "block_id": "t00001",
          "type": "text",
          "text": "物入库、保管、出库及费用结算等环节，明确双方责任边界与操作标准。保管方须按约定条件",
          "parent_id": "h0001",
          "level": null,
          "size": 11,
          "font": "cjk",
